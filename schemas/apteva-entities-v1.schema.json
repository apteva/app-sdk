{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apteva-entities-v1.schema.json",
  "title": "Apteva entities export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "items"
  ],
  "properties": {
    "contract": {
      "const": "apteva.entities/v1"
    },
    "revision": {
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "format": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^#\\\\]*$"
        }
      }
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/entityRef"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "label"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/entityRef"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "parent": {
          "$ref": "#/$defs/entityRef"
        },
        "relationships": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      }
    }
  }
}
