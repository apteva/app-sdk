{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apteva-summary-v1.schema.json",
  "title": "Apteva summary export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sections"
  ],
  "properties": {
    "contract": {
      "const": "apteva.summary/v1"
    },
    "revision": {
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "sections": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "format": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^#\\\\]*$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
}
